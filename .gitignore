# ランタイム生成物（各自のローカルに閉じる。コミットしない）
# SQLite には API キーが保存されるため、バックアップやジャーナルも含めて確実に除外する
# （`*.sqlite` だけだと ezbot.sqlite.bak-xxxx のような複製が漏れる）
/data/*.sqlite*
/data/uploads/*
!/data/uploads/.gitkeep

# APIキー等の秘密（もし config を置く場合）
/config.local.php
.env

# OS / エディタ
.DS_Store
Thumbs.db
*.log
.vscode/
.idea/
